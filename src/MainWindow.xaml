<Window x:Class="Nocturne.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nocturne" Background="#111719" Foreground="#EAEDE8" FontFamily="Microsoft YaHei UI" FontSize="13" Title="Nocturne · 夜曲钢琴" Width="1260" Height="850" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" InputMethod.IsInputMethodEnabled="False" AllowDrop="True" Drop="FileDrop" PreviewKeyDown="KeyDownHandler" PreviewKeyUp="KeyUpHandler">
<Grid Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="N O C T U R N E" FontFamily="Georgia" FontSize="30"/><TextBlock Text="夜曲钢琴   /   YOUR PERSONAL PIANO STUDIO" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="● 正在连接音源" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,22,0"/><Button Content="连接音源" Click="ConnectClick"/><Button Content="设置与按键映射" Click="SettingsClick"/></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  /  INSTRUMENT" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="一架好琴，随时在手边。" FontSize="21" Margin="0,10,0,16"/><ComboBox x:Name="Presets" SelectionChanged="PresetChanged" DisplayMemberPath="Name"/><TextBlock x:Name="AudioLabel" Text="Pianoteq 9 · 物理建模音源" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  /  EXPRESSION" Foreground="{StaticResource Muted}" FontSize="10"/><Grid Margin="0,14,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="触键力度" VerticalAlignment="Center"/><Slider x:Name="Velocity" Grid.Column="1" Minimum="1" Maximum="127" Value="88" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ExpressionChanged"/><TextBlock x:Name="VelocityText" Grid.Column="2" Text="88" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="输出音量" VerticalAlignment="Center"/><Slider x:Name="Volume" Grid.Column="1" Minimum="-40" Maximum="6" Value="0" ValueChanged="VolumeChanged"/><TextBlock x:Name="VolumeText" Grid.Column="2" Text="0 dB" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid><TextBlock Text="Space 按住延音  ·  ↑ ↓ 切换八度  ·  Esc 紧急止音" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border>
</Grid>
<Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid Margin="20,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="演奏空间" FontSize="15"/><TextBlock Text="LIVE PIANO" Margin="13,3,0,0" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="OctaveLabel" Text="移调 0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="− 八度" Click="OctaveDown" Padding="10,5"/><Button Content="+ 八度" Click="OctaveUp" Padding="10,5"/><Button x:Name="SustainButton" Content="延音 OFF" Click="SustainClick" Padding="10,5"/></StackPanel></Grid><local:PianoView x:Name="Piano" Grid.Row="1"/><Grid Grid.Row="2" Margin="20,0"><TextBlock Text="C2 — C7  /  可视琴键范围 · 键盘可移调" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="NoteLabel" Text="准备好，开始弹奏" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/></Grid></Grid></Border>
<Border Grid.Row="6" Style="{StaticResource Card}" Padding="22,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="03  /  MIDI PLAYER" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SongLabel" Text="选择一首曲子，或将 MIDI 拖到窗口" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开 MIDI" Click="OpenClick"/><Button Content="示范曲" Click="DemoClick"/><Button x:Name="PlayButton" Content="▶ 播放" Background="{StaticResource Accent}" Foreground="#14251F" Click="PlayClick"/><Button Content="■ 停止" Click="StopClick"/><CheckBox x:Name="Loop" Content="循环" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Focusable="False"/></StackPanel></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><Slider x:Name="Progress" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd"/><TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource Muted}"/></Grid><TextBlock x:Name="Status" Text="正在启动…" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
</Grid></Window>
